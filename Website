<!DOCTYPE html><html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"><title>My First Website | Web Designer</title>

<!-- Stylish Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Poppins', sans-serif;
        color: white;

        /* TWO DOODLE COLOURS */
        background:
            radial-gradient(circle at 10% 20%, #8b5cf6 0%, transparent 25%),
            radial-gradient(circle at 90% 80%, #06b6d4 0%, transparent 25%),
            #0b1020;

        background-attachment: fixed;
        overflow-x: hidden;
    }

    /* DOODLE BACKGROUND */

    body::before {
        content: "✦   ✧   ○   △   ☆   +   ✦   ○   ♢   ✧   +   ☆   ○";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;

        font-size: 45px;
        line-height: 130px;
        letter-spacing: 35px;

        color: rgba(255,255,255,0.08);

        word-wrap: break-word;
        pointer-events: none;
        z-index: -1;
    }

    /* NAVBAR */

    nav {
        position: sticky;
        top: 0;
        z-index: 1000;

        padding: 18px 7%;

        display: flex;
        justify-content: space-between;
        align-items: center;

        background: rgba(11,16,32,0.75);
        backdrop-filter: blur(15px);

        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .logo {
        font-family: 'Montserrat', sans-serif;
        font-size: 25px;
        font-weight: 800;

        background: linear-gradient(
            90deg,
            #a78bfa,
            #22d3ee
        );

        -webkit-background-clip: text;
        color: transparent;
    }

    nav ul {
        list-style: none;
        display: flex;
        gap: 25px;
    }

    nav ul li a {
        color: white;
        text-decoration: none;
        font-weight: 500;
        transition: 0.3s;
    }

    nav ul li a:hover {
        color: #22d3ee;
    }

    /* HERO */

    .hero {
        min-height: 90vh;

        display: flex;
        justify-content: center;
        align-items: center;

        text-align: center;
        padding: 30px;
    }

    .hero-content {
        max-width: 800px;
    }

    .small-text {
        color: #22d3ee;
        font-weight: 600;
        letter-spacing: 2px;
        margin-bottom: 15px;
    }

    .hero h1 {
        font-family: 'Montserrat', sans-serif;

        font-size: clamp(45px, 8vw, 75px);
        font-weight: 800;

        line-height: 1.1;

        margin-bottom: 20px;

        background: linear-gradient(
            90deg,
            #ffffff,
            #a78bfa,
            #22d3ee
        );

        -webkit-background-clip: text;
        color: transparent;
    }

    .hero p {
        font-size: 19px;
        color: #d1d5db;
        max-width: 650px;
        margin: auto;
    }

    /* BUTTON */

    .btn {
        display: inline-block;

        margin-top: 30px;
        padding: 14px 28px;

        background: linear-gradient(
            90deg,
            #8b5cf6,
            #06b6d4
        );

        color: white;

        text-decoration: none;

        border-radius: 50px;

        font-weight: 600;

        box-shadow:
            0 10px 30px rgba(6,182,212,0.25);

        transition: 0.3s;
    }

    .btn:hover {
        transform: translateY(-4px) scale(1.04);

        box-shadow:
            0 15px 40px rgba(139,92,246,0.4);
    }

    /* SECTIONS */

    section {
        padding: 90px 8%;
        text-align: center;
    }

    section h2 {
        font-family: 'Montserrat', sans-serif;

        font-size: 40px;
        font-weight: 800;

        margin-bottom: 15px;
    }

    .intro {
        max-width: 700px;
        margin: auto;

        color: #cbd5e1;
        font-size: 17px;
    }

    /* GLASS CARDS */

    .services {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 25px;

        margin-top: 45px;
    }

    .card {
        padding: 35px 25px;

        border-radius: 20px;

        background:
            rgba(255,255,255,0.07);

        backdrop-filter: blur(12px);

        border:
            1px solid rgba(255,255,255,0.12);

        transition: 0.35s;
    }

    .card:hover {
        transform: translateY(-10px);

        border-color: #22d3ee;

        box-shadow:
            0 15px 40px rgba(0,0,0,0.3);
    }

    .card h3 {
        font-family: 'Montserrat', sans-serif;

        color: #22d3ee;

        font-size: 21px;

        margin-bottom: 12px;
    }

    .card p {
        color: #cbd5e1;
    }

    /* ABOUT */

    #about {
        background:
            rgba(139,92,246,0.08);
    }

    /* CONTACT */

    .contact-box {
        max-width: 750px;

        margin: 35px auto 0;

        padding: 45px 30px;

        border-radius: 25px;

        background:
            rgba(255,255,255,0.08);

        backdrop-filter: blur(15px);

        border:
            1px solid rgba(255,255,255,0.12);
    }

    .contact-box h3 {
        font-family: 'Montserrat', sans-serif;

        font-size: 27px;

        margin-bottom: 15px;
    }

    .contact-box p {
        color: #cbd5e1;
    }

    .contact-btn {
        display: inline-block;

        margin-top: 25px;

        padding: 13px 25px;

        border-radius: 50px;

        background: #22c55e;

        color: white;

        text-decoration: none;

        font-weight: 600;

        transition: 0.3s;
    }

    .contact-btn:hover {
        transform: scale(1.05);
    }

    /* FOOTER */

    footer {
        text-align: center;

        padding: 30px;

        background: rgba(0,0,0,0.3);

        color: #94a3b8;

        font-size: 14px;
    }

    /* MOBILE */

    @media (max-width: 768px) {

        nav {
            flex-direction: column;
            gap: 12px;
        }

        nav ul {
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .services {
            grid-template-columns: 1fr;
        }

        section {
            padding: 70px 6%;
        }

        section h2 {
            font-size: 32px;
        }

        .hero p {
            font-size: 16px;
        }
    }

</style>

</head><body><!-- NAVIGATION -->

<nav>

    <div class="logo">
        MyWebsite
    </div>

    <ul>
        <li>
            <a href="#home">Home</a>
        </li>

        <li>
            <a href="#about">About</a>
        </li>

        <li>
            <a href="#services">Services</a>
        </li>

        <li>
            <a href="#contact">Contact</a>
        </li>
    </ul>

</nav>


<!-- HOME -->

<section class="hero" id="home">

    <div class="hero-content">

        <div class="small-text">
            ✦ WELCOME TO MY WEBSITE ✦
        </div>

        <h1>
            I Create Websites
        </h1>

        <p>
            Hi everyone! 👋
            This is my first website.
            I create simple, modern and attractive
            websites for people who have their own ideas.
        </p>

        <a href="#contact" class="btn">
            🚀 Get Your Website
        </a>

    </div>

</section>


<!-- ABOUT -->

<section id="about">

    <h2>
        About Me
    </h2>

    <p class="intro">
        Hello! I'm learning web development and this is
        one of my first websites. I enjoy creating websites,
        experimenting with designs and turning ideas into
        real webpages.
    </p>

</section>


<!-- SERVICES -->

<section id="services">

    <h2>
        What I Can Make
    </h2>

    <p class="intro">
        Have an idea for a website?
        I can create a simple website based on your idea.
    </p>


    <div class="services">

        <div class="card">

            <h3>
                🌐 Personal Website
            </h3>

            <p>
                A website for your profile,
                portfolio, project or personal brand.
            </p>

        </div>


        <div class="card">

            <h3>
                🏪 Business Website
            </h3>

            <p>
                A website where you can show your
                business, services and contact details.
            </p>

        </div>


        <div class="card">

            <h3>
                🎨 Custom Design
            </h3>

            <p>
                Tell me your idea and I can create
                a website design around it.
            </p>

        </div>

    </div>

</section>


<!-- CONTACT -->

<section id="contact">

    <h2>
        Interested?
    </h2>

    <p class="intro">
        If you are interested in getting your own website,
        feel free to contact me!
    </p>


    <div class="contact-box">

        <h3>
            Let's Create Something Amazing 🚀
        </h3>

        <p>
            Have an idea for a website?
            Send me a message and tell me what you need.
        </p>


        <!-- CHANGE THE NUMBER BELOW -->

        <a
            class="contact-btn"
            href="https://wa.me/919999999999"
            target="_blank">

            💬 Contact Me on WhatsApp

        </a>

    </div>

</section>


<!-- FOOTER -->

<footer>

    © 2026 MyWebsite • Made with ❤️ and HTML

</footer>

</body>
</html>
